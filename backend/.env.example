PORT=3000

# Banco de dados (Postgres / Neon)
# Runtime: string COM pooler (host contendo "-pooler"). Evite channel_binding e use
# sslmode=verify-full (ou uselibpqcompat=true&sslmode=require) para o aviso do pg sumir.
DATABASE_URL=
# Migrations (prisma migrate): string DIRETA, sem "-pooler". Se vazio, usa DATABASE_URL.
DIRECT_URL=

# Autenticação
JWT_SECRET=

# Pedidos: minutos que o estoque fica reservado para um pedido aguardando pagamento.
# Depois disso o pedido é cancelado automaticamente e o estoque volta. Padrão: 30
ORDER_EXPIRATION_MINUTES=30
# Rede de segurança periódica (acorda o banco do Neon; deixe false). A expiração normal
# acontece "de carona" nas requisições que já consultam o banco.
ORDER_EXPIRATION_JOB_ENABLED=false
# Intervalo do job acima. Padrão 60, mínimo 15
ORDER_EXPIRATION_JOB_MINUTES=60
# Intervalo mínimo entre duas verificações oportunistas no mesmo processo. Padrão 10
ORDER_EXPIRATION_CHECK_THROTTLE_MINUTES=10

# Pix: minutos de validade do QR (padrão 60, mínimo 30 exigido pelo Mercado Pago)
PIX_EXPIRATION_MINUTES=60
# Pix: % de desconto sobre produtos (já com cupom), sem frete. 0 desliga
PIX_DISCOUNT_PERCENT=5

# Mercado Pago
MERCADOPAGO_ACCESS_TOKEN=
FRONTEND_URL=
BACKEND_URL=

# Cloudinary (imagens de produto)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Melhor Envio — cotação de frete (OAuth2) — https://docs.melhorenvio.com.br
# App cadastrado no painel: Integrações → Área Dev. → Cadastrar Aplicativo
MELHORENVIO_CLIENT_ID=
MELHORENVIO_CLIENT_SECRET=
# Precisa ser IDÊNTICA à cadastrada no app. Aponta para o backend:
# <BACKEND_URL>/integrations/melhorenvio/callback
MELHORENVIO_REDIRECT_URI=
# "sandbox" (testes) ou "production"
MELHORENVIO_ENV=sandbox
# Exigido pelo Melhor Envio em toda chamada: "Nome da aplicação (email@contato.com)"
MELHORENVIO_USER_AGENT=Mandala Crystais (seu-email@exemplo.com)
# Opcional: limitar serviços cotados (ex.: 1,2,17). Vazio = todos os disponíveis na conta.
MELHORENVIO_SERVICES=
# CEP de onde os produtos são enviados
STORE_ZIP_CODE=

# Gemini (Google AI Studio) — botão "Pedir pra IA" no cadastro de produto
# Chave gratuita: https://aistudio.google.com/apikey | limites: https://aistudio.google.com/rate-limit
GEMINI_API_KEY=
# Opcional. Padrão: gemini-3.8-flash
GEMINI_MODEL=
# Opcional. Modelos tentados em ordem se o principal estiver sobrecarregado (503) ou sem cota (429).
# Padrão: gemini-3.5-flash
GEMINI_FALLBACK_MODELS=

# Brevo — e-mails ("esqueci minha senha" e ofertas) — https://developers.brevo.com
# API key: Brevo → SMTP & API → API Keys. O remetente precisa estar verificado na Brevo.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Mandala Crystais
# (FRONTEND_URL, acima, monta os links de redefinir senha e de descadastro)

# Obs.: access_token/refresh_token do Melhor Envio NÃO ficam aqui — são gravados na
# tabela integration_tokens ao autorizar o app no admin e renovados automaticamente.
