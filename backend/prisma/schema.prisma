// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELED
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
  REFUNDED
}

enum CouponType {
  PERCENTAGE
  FIXED
}

model User {
  id       String @id @default(uuid())
  name     String
  email    String @unique
  password String
  phone    String?
  role     Role   @default(CUSTOMER)

  // "Esqueci minha senha": guarda só o HASH (sha256) do token enviado por e-mail
  reset_password_token      String?   @unique
  reset_password_expires_at DateTime?

  // LGPD: true = não recebe mais e-mails de oferta (descadastro pelo link do e-mail)
  marketing_opt_out Boolean @default(false)

  addresses Address[]
  cart      Cart?
  orders    Order[]
  coupons   Coupon[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Address {
  id           String @id @default(uuid())
  street       String
  number       String
  complement   String?
  neighborhood String
  city         String
  state        String
  zip_code     String

  user_id String
  user    User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  orders Order[]

  createdAt DateTime @default(now())

  @@map("addresses")
}

model Category {
  id   String @id @default(uuid())
  name String
  slug String @unique

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("categories")
}

model Product {
  id          String @id @default(uuid())
  name        String
  slug        String @unique
  price       Int
  promo_price Int?
  description String
  banner      String
  stock       Int     @default(0)
  disabled    Boolean @default(false)
  // Aparece no carrossel de destaques no topo da home
  featured    Boolean @default(false)

  // Pacote para cotação de frete. Opcionais: produtos antigos usam um pacote
  // padrão (ver services/shipping/buildShippingProducts.ts) até o lojista preencher.
  weight_grams Int?
  height_cm    Int?
  width_cm     Int?
  length_cm    Int?

  // SEO/acessibilidade (podem ser gerados pelo "Pedir pra IA" no admin e editados)
  meta_description String? // <meta name="description"> da página do produto (até 160 caracteres)
  image_alt_text   String? // alt da imagem principal

  category_id String
  category    Category @relation(fields: [category_id], references: [id], onDelete: Cascade)

  cartItems  CartItem[]
  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("products")
}

model Cart {
  id String @id @default(uuid())

  user_id String @unique
  user    User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  items CartItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("carts")
}

model CartItem {
  id       String @id @default(uuid())
  quantity Int

  cart_id String
  cart    Cart @relation(fields: [cart_id], references: [id], onDelete: Cascade)

  product_id String
  product    Product @relation(fields: [product_id], references: [id])

  @@unique([cart_id, product_id])

  @@map("cart_items")
}

model Order {
  id            String      @id @default(uuid())
  status        OrderStatus @default(PENDING)
  subtotal      Int
  discount      Int         @default(0)
  shipping_cost Int         @default(0)
  total         Int

  // Serviço de frete escolhido no checkout (ex.: "PAC", "SEDEX") e prazo cotado
  shipping_service       String?
  shipping_delivery_days Int?
  // true = o Melhor Envio estava fora do ar ao finalizar e o frete gravado é o último
  // valor cotado na tela do cliente (conferir manualmente no admin)
  shipping_cost_estimated Boolean @default(false)

  user_id String
  user    User @relation(fields: [user_id], references: [id])

  address_id String
  address    Address @relation(fields: [address_id], references: [id])

  coupon_id String?
  coupon    Coupon? @relation(fields: [coupon_id], references: [id])

  items   OrderItem[]
  payment Payment?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("orders")
}

model OrderItem {
  id         String @id @default(uuid())
  quantity   Int
  unit_price Int

  order_id String
  order    Order @relation(fields: [order_id], references: [id], onDelete: Cascade)

  product_id String
  product    Product @relation(fields: [product_id], references: [id])

  @@map("order_items")
}

model Payment {
  id                  String        @id @default(uuid())
  provider            String        @default("mercado_pago")
  provider_payment_id String?
  status              PaymentStatus @default(PENDING)
  method              String?
  raw_payload         Json?

  order_id String @unique
  order    Order @relation(fields: [order_id], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("payments")
}

model Coupon {
  id         String @id @default(uuid())
  code       String @unique
  type       CouponType
  value      Int
  active     Boolean    @default(true)
  expires_at DateTime?

  // Só vale na primeira compra paga do cliente (ex.: BEMVINDA10)
  first_purchase_only Boolean @default(false)

  // null = cupom genérico (qualquer cliente); preenchido = cupom exclusivo do usuário
  user_id String?
  user    User?   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  orders Order[]

  createdAt DateTime @default(now())

  @@map("coupons")
}

// Configurações editáveis da vitrine — tabela com uma única linha (singleton)
model StoreSettings {
  id                       String   @id @default(uuid())
  announcement_text        String   @default("")
  announcement_coupon_code String?
  free_shipping_threshold  Int? // em centavos
  trust_strip_items        Json // [{ icon: "Gem", label: "Pedras 100% naturais" }, ...]
  updatedAt                DateTime @updatedAt

  @@map("store_settings")
}

// Tokens OAuth2 de integrações externas (ex.: Melhor Envio). Ficam no banco, e não
// no .env, porque expiram e são renovados automaticamente pelo backend.
model IntegrationToken {
  provider           String   @id // ex.: "melhorenvio"
  access_token       String
  refresh_token      String
  expires_at         DateTime // validade do access_token (30 dias no Melhor Envio)
  refresh_expires_at DateTime? // validade estimada do refresh_token (45 dias)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("integration_tokens")
}
